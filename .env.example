# JANUS 2 configuration
# Copy to .env and fill in values

# ─── LLM Backend ─────────────────────────────────────────────────
# "anthropic" (pending Officina format recovery) or "ollama"
LLM_BACKEND=ollama

# Anthropic (when backend=anthropic)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_AGENT_MODEL=claude-haiku-4-5-20251001

# Ollama (when backend=ollama)
OLLAMA_HOST=http://localhost:11434
JANUS_MODEL=gemma4:31b-cloud

# ─── Sandbox ─────────────────────────────────────────────────────
# Directory for sandboxed command execution
# JANUS_SANDBOX=/path/to/sandbox
